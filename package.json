{
  "name": "1sms-store",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/copy-basis.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx workers/3d.worker.ts",
    "postinstall": "prisma generate && node scripts/copy-basis.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@gsap/react": "^2.1.2",
    "@prisma/client": "^6.16.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.4.0",
    "bullmq": "^5.58.0",
    "@gltf-transform/cli": "^4.2.1",
    "gsap": "^3.14.0",
    "ioredis": "^5.7.0",
    "lenis": "^1.3.11",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "^0.34.4",
    "three": "^0.181.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.181.0",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.0.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}