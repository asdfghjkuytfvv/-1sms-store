# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STORE_WHATSAPP=9647xxxxxxxxx
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onesms?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Admin password authentication (generate a random salt and 64-byte scrypt hash; see README)
ADMIN_PASSWORD_SALT=replace-with-random-32-byte-hex
ADMIN_PASSWORD_HASH=replace-with-scrypt-hex
AUTH_SECRET=replace-with-32-byte-or-longer-random-secret

# Meshy Image-to-3D API
MESHY_API_KEY=

# Optional remove.bg preprocessing. If absent, Sharp normalization is used.
REMOVE_BG_API_KEY=

# S3-compatible storage (Cloudflare R2, AWS S3, or MinIO)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=1sms-store-assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=https://cdn.example.com
S3_FORCE_PATH_STYLE=false

# Worker
GENERATION_MAX_MINUTES=45
MESHY_MODEL=latest
MODEL_MAX_BYTES=104857600
